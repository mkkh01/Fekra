+        const id = button.dataset.chooseNation!;
+        selectPlayer(this.state, id);
+        this.toast(`أصبحت قائد ${nationById(this.state, id)?.name || 'المملكة'}`);
+        this.render();
+      };
+    });
+    this.elements.selectionPanel.querySelectorAll<HTMLElement>('[data-select-army]').forEach((button) => {
+      button.onclick = () => this.selectArmy(button.dataset.selectArmy!);
+    });
+    this.elements.selectionPanel.querySelectorAll<HTMLElement>('[data-upgrade-city]').forEach((button) => {
+      button.onclick = () => {
+        queuePlayerAction(this.state, { type: 'upgrade_city', nationId: this.state.playerNationId, cityId: button.dataset.upgradeCity! });
+        this.toast('أضيف أمر التحصين إلى الخطة');
+        this.render();
+      };
+    });
+    this.elements.commandPanel.querySelectorAll<HTMLElement>('[data-recruit]').forEach((button) => {
+      button.onclick = () => {
+        const region = this.state.selectedRegionId || nationRegions(this.state, this.state.playerNationId)[0]?.id;
+        if (!region) return;
+        queuePlayerAction(this.state, { type: 'recruit', nationId: this.state.playerNationId, regionId: region, unit: button.dataset.recruit as 'infantry' | 'archers' | 'cavalry' });
+        this.toast('أضيف أمر التجنيد إلى الخطة');
+        this.render();
+      };
+    });
+    this.elements.commandPanel.querySelectorAll<HTMLElement>('[data-spy-target]').forEach((button) => {
+      button.onclick = () => {
+        queuePlayerAction(this.state, { type: 'spy', nationId: this.state.playerNationId, targetNationId: button.dataset.spyTarget! });
+        this.toast('أرسلت أمرًا سريًا إلى شبكة الاستخبارات');
+        this.render();
+      };
+    });
+    this.elements.commandPanel.querySelectorAll<HTMLElement>('[data-order]').forEach((button) => {
+      button.onclick = () => {
+        const army = this.state.selectedArmyId ? armyById(this.state, this.state.selectedArmyId) : undefined;
+        if (!army) return;
+        const target = (this.elements.commandPanel.querySelector('#targetRegionSelect') as HTMLSelectElement)?.value;
+        const type = button.dataset.order as 'move' | 'attack' | 'scout' | 'defend';
+        const success = setArmyOrder(this.state, army.id, { type, targetRegionId: type === 'defend' ? undefined : target, stance: type === 'attack' ? 'aggressive' : 'balanced' });
+        this.toast(success ? `تم تسجيل أمر ${type === 'attack' ? 'الهجوم' : type === 'move' ? 'الحركة' : type === 'scout' ? 'الاستطلاع' : 'الدفاع'}` : 'لا يمكن تنفيذ هذا الأمر من موقع الجيش الحالي');
+        this.render();
+      };
+    });
+    this.elements.diplomacyPanel.querySelectorAll<HTMLElement>('[data-treaty]').forEach((button) => {
+      button.onclick = () => {
+        queuePlayerAction(this.state, { type: 'treaty', nationId: this.state.playerNationId, targetNationId: button.dataset.target!, treatyType: button.dataset.treaty as TreatyType });
+        this.toast('أضيف العرض الدبلوماسي إلى الخطة');
+        this.render();
+      };
+    });
+  }
+
+  private endTurn(): void {
+    if (this.state.phase !== 'playing') return;
+    resolveTurn(this.state);
+    const errors = validateState(this.state);
+    if (errors.length) {
+      console.error('State validation failed', errors);
+      this.toast('تم إيقاف الدور بسبب مشكلة في حالة العالم. راجع سجل المطور.');
+    } else if ((this.state as GameState).phase === 'won') {
+      this.toast('انتصار! سقط التاج الحديدي.');
+    } else if ((this.state as GameState).phase === 'lost') {
+      this.toast('انتهت اللعبة. يمكنك بدء محاولة جديدة.');
+    } else {
+      this.toast(`بدأ ${getMonthName(this.state.month)} من السنة ${this.state.year}`);
+    }
+    this.saveSilently();
+    this.render();
+  }
+
+  private saveGame(): void {
+    this.saveSilently();
+    this.toast('تم حفظ تاريخ المملكة في هذا المتصفح');
+  }
+
+  private saveSilently(): void {
+    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(this.state)); } catch (error) { console.warn('Save failed', error); }
+  }
+
+  private loadGame(): void {
+    try {
+      const raw = localStorage.getItem(STORAGE_KEY);
+      if (!raw) { this.toast('لا يوجد حفظ سابق على هذا المتصفح'); return; }
+      const loaded = JSON.parse(raw) as GameState;
+      const errors = validateState(loaded);
+      if (errors.length) { this.toast('ملف الحفظ غير صالح'); return; }
+      this.state = loaded;
+      this.toast('تم تحميل آخر حالة محفوظة');
+      this.render();
+    } catch (error) {
+      console.error(error);
+      this.toast('تعذر تحميل ملف الحفظ');
+    }
+  }
+
+  private resetGame(): void {
+    if (this.state.phase === 'playing' && !window.confirm('بدء لعبة جديدة؟ سيتم الاحتفاظ بالحفظ الحالي فقط إذا ضغطت حفظًا أولًا.')) return;
+    this.state = createScenario(Date.now() % 1000000);
+    this.toast('تم إنشاء عالم جديد');
+    this.render();
+  }
+
+  private toast(message: string): void {
+    const item = document.createElement('div');
+    item.className = 'toast';
+    item.textContent = message;
+    this.elements.toastRegion.appendChild(item);
+    window.setTimeout(() => item.classList.add('show'), 10);
+    if (this.toastTimer) window.clearTimeout(this.toastTimer);
+    this.toastTimer = window.setTimeout(() => {
+      item.classList.remove('show');
+      window.setTimeout(() => item.remove(), 260);
+    }, 2600);
+  }
+}
+
+function totalArmySizeSafe(army: { infantry: number; archers: number; cavalry: number }): number {
+  return Math.max(0, army.infantry + army.archers + army.cavalry);
+}
