+.objective-progress { margin-top: 11px; }
+.objective-progress > div, .objective-foot, .panel-title-row, .subsection-title, .ownership-row, .selection-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
+.objective-progress > div { color: var(--muted); font-size: 9px; }
+.objective-progress b { color: #e59b8e; }
+.objective-progress .meter { margin-top: 6px; }
+.objective-foot { margin-top: 9px; color: var(--muted); font-size: 9px; }
+.turn-tag, .later-note, .event-count { padding: 3px 6px; border: 1px solid var(--line-soft); border-radius: 5px; color: var(--gold); font-size: 8px; }
+
+.selection-card { min-height: 170px; }
+.selection-head { align-items: flex-start; }
+.terrain-badge, .production-pill { padding: 3px 7px; border: 1px solid var(--line-soft); border-radius: 5px; color: var(--muted); font-size: 9px; white-space: nowrap; }
+.ownership-row { justify-content: flex-start; margin-top: 8px; padding-bottom: 9px; border-bottom: 1px solid var(--line-soft); color: var(--muted); font-size: 9px; }
+.production-pill { margin-right: auto; color: var(--gold); }
+.subsection { margin-top: 10px; }
+.subsection-title { margin-bottom: 5px; color: var(--muted); font-size: 9px; }
