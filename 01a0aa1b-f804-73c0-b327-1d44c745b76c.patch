+  .sidebar > .panel { width: 100%; }
+  .resource-grid { grid-template-columns: repeat(3, 1fr); }
+  .map-footer { flex-direction: column; gap: 3px; }
+  .seed-label { direction: ltr; text-align: right; }
+  .top-actions .icon-button, .top-actions .danger-button { padding: 6px 7px; font-size: 9px; }
+}
