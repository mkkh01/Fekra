diff --git a/src/sim/backtest.ts b/src/sim/backtest.ts
new file mode 100644
index 0000000..15d22bd
--- /dev/null
+++ b/src/sim/backtest.ts
@@ -0,0 +1,165 @@
+declare const process: any;
+
+import {
+  createScenario,
+  nationArmySize,
+  nationById,
+  nationCities,
+  nationRegions,
+  queuePlayerAction,
+  regionById,
+  resolveTurn,
+  selectPlayer,
+  setArmyOrder,
+  snapshotSummary,
+  validateState,
+} from '../core/simulation.js';
+import { GameState } from '../core/types.js';
+
+export interface BacktestOptions {
+  games?: number;
+  turnsPerGame?: number;
+  seed?: number;
+  playerNationId?: string;
+}
+
+export interface BacktestResult {
+  games: number;
+  turnsPerGame: number;
+  simulatedTurns: number;
+  victories: number;
+  defeats: number;
+  timeouts: number;
+  restarts: number;
+  averageBattles: number;
+  averageCaptures: number;
+  averageWars: number;
+  averageRebellions: number;
+  averageSpyOperations: number;
+  averageTreaties: number;
+  invariantErrors: string[];
+  finalStates: Array<Record<string, unknown>>;
+  elapsedMs: number;
+}
+
+function issueTestOrders(state: GameState): void {
+  if (state.phase !== 'playing') return;
+  const player = nationById(state, state.playerNationId);
+  if (!player) return;
+  const capital = nationCities(state, player.id).find((city) => city.isCapital);
+  const capitalRegion = capital ? regionById(state, capital.regionId) : undefined;
+  if (capitalRegion && state.turn % 2 === 0) {
+    queuePlayerAction(state, { type: 'recruit', nationId: player.id, regionId: capitalRegion.id, unit: state.turn % 4 === 0 ? 'archers' : 'infantry' });
+  }
+  if (capital && state.turn % 7 === 0) queuePlayerAction(state, { type: 'upgrade_city', nationId: player.id, cityId: capital.id });
+  if (state.turn % 5 === 0) {
+    const target = state.nations.find((nation) => nation.id === 'falor' && nation.alive);
+    if (target) queuePlayerAction(state, { type: 'spy', nationId: player.id, targetNationId: target.id });
+  }
+  if (state.turn % 6 === 0) {
+    const target = state.nations.find((nation) => nation.id === 'union' && nation.alive && nation.id !== player.id);
+    if (target) queuePlayerAction(state, { type: 'treaty', nationId: player.id, targetNationId: target.id, treatyType: 'trade' });
+  }
+  for (const army of state.armies.filter((item) => item.ownerId === player.id)) {
+    const current = regionById(state, army.regionId);
+    const enemyNeighbor = current?.neighbors.map((id) => regionById(state, id)).find((region) => region?.ownerId === 'falor');
+    if (enemyNeighbor && state.turn % 3 === 0) setArmyOrder(state, army.id, { type: 'attack', targetRegionId: enemyNeighbor.id, stance: 'balanced' });
+    else setArmyOrder(state, army.id, { type: 'defend' });
+  }
+}
+
+function newCampaign(seed: number, playerNationId: string): GameState {
+  return selectPlayer(createScenario(seed), playerNationId);
+}
+
+export function runBacktest(options: BacktestOptions = {}): BacktestResult {
+  const games = Math.max(1, Math.floor(options.games ?? 50));
+  const turnsPerGame = Math.max(1, Math.floor(options.turnsPerGame ?? 240));
+  const seed = options.seed ?? 810241;
+  const playerNationId = options.playerNationId ?? 'noran';
+  const started = Date.now();
+  let simulatedTurns = 0;
+  let victories = 0;
+  let defeats = 0;
+  let timeouts = 0;
+  let restarts = 0;
+  let battles = 0;
+  let captures = 0;
+  let wars = 0;
+  let rebellions = 0;
+  let spyOperations = 0;
+  let treaties = 0;
+  const invariantErrors: string[] = [];
+  const finalStates: Array<Record<string, unknown>> = [];
+
+  for (let game = 0; game < games; game += 1) {
+    let state = newCampaign(seed + game * 7919, playerNationId);
+    for (let localTurn = 0; localTurn < turnsPerGame; localTurn += 1) {
+      if (state.phase !== 'playing') {
+        if (state.phase === 'won') victories += 1;
+        if (state.phase === 'lost') defeats += 1;
+        restarts += 1;
+        state = newCampaign(seed + game * 7919 + (restarts + 1) * 131071, playerNationId);
+      }
+      issueTestOrders(state);
+      const beforeMetrics = { ...state.metrics };
+      resolveTurn(state);
+      simulatedTurns += 1;
+      battles += state.metrics.battles - beforeMetrics.battles;
+      captures += state.metrics.captures - beforeMetrics.captures;
+      wars += state.metrics.warsStarted - beforeMetrics.warsStarted;
+      rebellions += state.metrics.rebellions - beforeMetrics.rebellions;
+      spyOperations += state.metrics.spyOperations - beforeMetrics.spyOperations;
+      treaties += state.metrics.treatiesAccepted - beforeMetrics.treatiesAccepted;
+      const errors = validateState(state);
+      if (errors.length > 0) invariantErrors.push(`game ${game + 1}, turn ${localTurn + 1}: ${errors.join(' | ')}`);
+      // Keep the stress run moving through terminal campaigns, but retain each
+      // terminal result as a useful balance signal above.
+    }
+    if (state.phase === 'won') victories += 1;
+    else if (state.phase === 'lost') defeats += 1;
+    else timeouts += 1;
+    if (game < 3) finalStates.push(snapshotSummary(state));
+
+    if (state.nations.some((nation) => nation.alive && nationRegions(state, nation.id).length === 0)) {
+      invariantErrors.push(`game ${game + 1}: دولة حية بلا مناطق`);
+    }
+    if (state.nations.some((nation) => nationArmyIdsMismatch(state, nation.id))) {
+      invariantErrors.push(`game ${game + 1}: قائمة جيوش الدولة غير متزامنة`);
+    }
+  }
+
+  const divisor = Math.max(1, games * turnsPerGame);
+  return {
+    games,
+    turnsPerGame,
+    simulatedTurns,
+    victories,
+    defeats,
+    timeouts,
+    restarts,
+    averageBattles: battles / divisor,
+    averageCaptures: captures / divisor,
+    averageWars: wars / divisor,
+    averageRebellions: rebellions / divisor,
+    averageSpyOperations: spyOperations / divisor,
+    averageTreaties: treaties / divisor,
+    invariantErrors,
+    finalStates,
+    elapsedMs: Date.now() - started,
+  };
+}
+
+function nationArmyIdsMismatch(state: GameState, nationId: string): boolean {
+  const nation = state.nations.find((item) => item.id === nationId);
+  if (!nation) return true;
+  const actual = new Set(state.armies.filter((army) => army.ownerId === nationId).map((army) => army.id));
+  const listed = new Set(nation.armyIds.filter((id) => actual.has(id)));
+  return listed.size !== actual.size;
+}
+
+if (typeof process !== 'undefined' && process.argv[1]?.endsWith('backtest.js')) {
+  const result = runBacktest({ games: 50, turnsPerGame: 240 });
+  console.log(JSON.stringify(result, null, 2));
+  if (result.invariantErrors.length > 0) process.exitCode = 1;
+}
