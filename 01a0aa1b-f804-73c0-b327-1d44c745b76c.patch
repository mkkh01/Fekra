diff --git a/src/rendering/mapRenderer.ts b/src/rendering/mapRenderer.ts
new file mode 100644
index 0000000..f998343
--- /dev/null
+++ b/src/rendering/mapRenderer.ts
@@ -0,0 +1,307 @@
+import { GameState, Region } from '../core/types.js';
+import { nationById, nationRegions, totalArmySize } from '../core/simulation.js';
+import { TERRAIN_ICONS, TERRAIN_LABELS } from '../core/icons.js';
+
+interface Point {
+  x: number;
+  y: number;
+}
+
+const TERRAIN_COLORS: Record<string, string> = {
+  plains: '#98845a',
+  hills: '#88775a',
+  mountains: '#666674',
+  forest: '#5b765f',
+  river: '#5a8290',
+  coast: '#71869a',
+};
+
+export class IsometricMapRenderer {
+  private canvas: HTMLCanvasElement;
+  private context: CanvasRenderingContext2D;
+  private state?: GameState;
+  private tileWidth = 152;
+  private tileHeight = 82;
+  private origin: Point = { x: 0, y: 0 };
+  private animation = 0;
+  private frame = 0;
+  private onRegionClick: (regionId: string) => void;
+  private resizeObserver?: ResizeObserver;
+
+  constructor(canvas: HTMLCanvasElement, onRegionClick: (regionId: string) => void) {
+    this.canvas = canvas;
+    this.context = canvas.getContext('2d')!;
+    this.onRegionClick = onRegionClick;
+    this.canvas.addEventListener('pointerdown', (event) => this.handlePointer(event));
+    this.resizeObserver = new ResizeObserver(() => this.resize());
+    this.resizeObserver.observe(canvas.parentElement || canvas);
+    this.resize();
+    this.animate();
+  }
+
+  setState(state: GameState): void {
+    this.state = state;
+  }
+
+  private resize(): void {
+    const rect = this.canvas.getBoundingClientRect();
+    const width = Math.max(320, rect.width || this.canvas.parentElement?.clientWidth || 800);
+    const height = Math.max(340, rect.height || this.canvas.parentElement?.clientHeight || 560);
+    const dpr = Math.min(window.devicePixelRatio || 1, 2);
+    this.canvas.width = Math.round(width * dpr);
+    this.canvas.height = Math.round(height * dpr);
+    this.context.setTransform(dpr, 0, 0, dpr, 0, 0);
+    this.tileWidth = Math.min(168, Math.max(104, width / 5.4));
+    this.tileHeight = this.tileWidth * 0.54;
+    this.origin = {
+      x: width / 2 - this.tileWidth * 0.2,
+      y: Math.max(72, height * 0.12),
+    };
+  }
+
+  private animate = (): void => {
+    this.animation += 0.018;
+    this.frame += 1;
+    if (this.state) this.draw(this.state);
+    requestAnimationFrame(this.animate);
+  };
+
+  private handlePointer(event: PointerEvent): void {
+    if (!this.state) return;
+    const rect = this.canvas.getBoundingClientRect();
+    const point = { x: event.clientX - rect.left, y: event.clientY - rect.top };
+    const region = this.state.regions.find((item) => this.pointInRegion(point, item));
+    if (region) this.onRegionClick(region.id);
+  }
+
+  private center(region: Region): Point {
+    return {
+      x: this.origin.x + (region.x - region.y) * this.tileWidth / 2,
+      y: this.origin.y + (region.x + region.y) * this.tileHeight / 2,
+    };
+  }
+
+  private diamond(region: Region, extraY = 0): Point[] {
+    const center = this.center(region);
+    return [
+      { x: center.x, y: center.y - this.tileHeight / 2 + extraY },
+      { x: center.x + this.tileWidth / 2, y: center.y + extraY },
+      { x: center.x, y: center.y + this.tileHeight / 2 + extraY },
+      { x: center.x - this.tileWidth / 2, y: center.y + extraY },
+    ];
+  }
+
+  private path(points: Point[]): void {
+    this.context.beginPath();
+    this.context.moveTo(points[0].x, points[0].y);
+    for (const point of points.slice(1)) this.context.lineTo(point.x, point.y);
+    this.context.closePath();
+  }
+
+  private pointInRegion(point: Point, region: Region): boolean {
+    const center = this.center(region);
+    const dx = Math.abs(point.x - center.x) / (this.tileWidth / 2);
+    const dy = Math.abs(point.y - center.y) / (this.tileHeight / 2);
+    return dx + dy <= 1.05;
+  }
+
+  private draw(state: GameState): void {
+    const rect = this.canvas.getBoundingClientRect();
+    const width = rect.width || 800;
+    const height = rect.height || 560;
+    const ctx = this.context;
+    ctx.clearRect(0, 0, width, height);
+
+    const background = ctx.createLinearGradient(0, 0, width, height);
+    background.addColorStop(0, '#192330');
+    background.addColorStop(0.55, '#202b35');
+    background.addColorStop(1, '#10161f');
+    ctx.fillStyle = background;
+    ctx.fillRect(0, 0, width, height);
+    this.drawAtmosphere(width, height);
+    this.drawConnections(state);
+
+    const ordered = [...state.regions].sort((a, b) => (a.x + a.y) - (b.x + b.y));
+    for (const region of ordered) this.drawRegion(state, region);
+    this.drawMapFrame(width, height);
+  }
+
+  private drawAtmosphere(width: number, height: number): void {
+    const ctx = this.context;
+    ctx.save();
+    ctx.globalAlpha = 0.14;
+    const glow = ctx.createRadialGradient(width * 0.26, height * 0.18, 5, width * 0.26, height * 0.18, width * 0.8);
+    glow.addColorStop(0, '#e0ad65');
+    glow.addColorStop(1, 'transparent');
+    ctx.fillStyle = glow;
+    ctx.fillRect(0, 0, width, height);
+    ctx.globalAlpha = 0.08;
+    ctx.strokeStyle = '#dcbf84';
+    ctx.lineWidth = 1;
+    for (let i = -height; i < width + height; i += 32) {
+      ctx.beginPath();
+      ctx.moveTo(i, 0);
+      ctx.lineTo(i - height, height);
+      ctx.stroke();
+    }
+    ctx.restore();
+  }
+
+  private drawConnections(state: GameState): void {
+    const ctx = this.context;
+    ctx.save();
+    ctx.lineWidth = 2;
+    for (const region of state.regions) {
+      for (const neighborId of region.neighbors) {
+        const neighbor = state.regions.find((item) => item.id === neighborId);
+        if (!neighbor || region.id > neighbor.id) continue;
+        const a = this.center(region);
+        const b = this.center(neighbor);
+        ctx.strokeStyle = region.ownerId === neighbor.ownerId ? 'rgba(225, 203, 150, .22)' : 'rgba(243, 174, 105, .42)';
+        ctx.setLineDash(region.ownerId === neighbor.ownerId ? [4, 8] : [2, 4]);
+        ctx.beginPath();
+        ctx.moveTo(a.x, a.y);
+        ctx.lineTo(b.x, b.y);
+        ctx.stroke();
+      }
+    }
+    ctx.setLineDash([]);
+    ctx.restore();
+  }
+
+  private drawRegion(state: GameState, region: Region): void {
+    const ctx = this.context;
+    const nation = nationById(state, region.ownerId);
+    const center = this.center(region);
+    const points = this.diamond(region, 9);
+    const selected = state.selectedRegionId === region.id;
+
+    ctx.save();
+    ctx.shadowColor = 'rgba(0,0,0,.42)';
+    ctx.shadowBlur = selected ? 22 : 11;
+    ctx.shadowOffsetY = 8;
+    this.path(points);
+    ctx.fillStyle = TERRAIN_COLORS[region.terrain] || '#777';
+    ctx.fill();
+    ctx.shadowColor = 'transparent';
+    ctx.globalAlpha = 0.7;
+    this.path(points);
+    ctx.fillStyle = nation?.color || '#777';
+    ctx.fill();
+    ctx.globalAlpha = 0.18;
+    this.path(points);
+    ctx.fillStyle = TERRAIN_COLORS[region.terrain] || '#777';
+    ctx.fill();
+    ctx.globalAlpha = 1;
+    ctx.lineWidth = selected ? 4 : 1.7;
+    ctx.strokeStyle = selected ? '#f5d58b' : (nation?.color || '#88939a');
+    ctx.stroke();
+    ctx.restore();
+
+    this.drawTerrainDetails(region, center);
+    this.drawRegionLabel(state, region, center);
+    this.drawCities(state, region, center);
+    this.drawArmies(state, region, center);
+  }
+
+  private drawTerrainDetails(region: Region, center: Point): void {
+    const ctx = this.context;
+    ctx.save();
+    ctx.globalAlpha = 0.58;
+    ctx.fillStyle = '#e8d9ad';
+    ctx.font = `${Math.max(16, this.tileWidth * 0.15)}px serif`;
+    ctx.textAlign = 'center';
+    ctx.textBaseline = 'middle';
+    ctx.fillText(TERRAIN_ICONS[region.terrain] || '·', center.x, center.y - 2);
+    ctx.restore();
+  }
+
+  private drawRegionLabel(state: GameState, region: Region, center: Point): void {
+    const ctx = this.context;
+    const nation = nationById(state, region.ownerId);
+    ctx.save();
+    ctx.textAlign = 'center';
+    ctx.textBaseline = 'top';
+    ctx.font = `600 ${Math.max(10, Math.min(14, this.tileWidth * 0.085))}px "Segoe UI", sans-serif`;
+    ctx.fillStyle = '#f4e8c8';
+    ctx.shadowColor = 'rgba(0,0,0,.9)';
+    ctx.shadowBlur = 4;
+    const label = region.name.length > 17 ? `${region.name.slice(0, 16)}…` : region.name;
+    ctx.fillText(label, center.x, center.y + this.tileHeight * 0.18);
+    ctx.font = `500 ${Math.max(9, Math.min(11, this.tileWidth * 0.07))}px "Segoe UI", sans-serif`;
+    ctx.fillStyle = nation?.color || '#aaa';
+    ctx.fillText(TERRAIN_LABELS[region.terrain] || '', center.x, center.y + this.tileHeight * 0.37);
+    ctx.restore();
+  }
+
+  private drawCities(state: GameState, region: Region, center: Point): void {
+    const ctx = this.context;
+    const cities = state.cities.filter((city) => city.regionId === region.id);
+    cities.forEach((city, index) => {
+      const x = center.x + (index - (cities.length - 1) / 2) * 17;
+      const y = center.y - this.tileHeight * 0.18;
+      ctx.save();
+      ctx.beginPath();
+      ctx.arc(x, y, city.isCapital ? 8 : 6, 0, Math.PI * 2);
+      ctx.fillStyle = city.isCapital ? '#f2c96c' : '#eee2c5';
+      ctx.fill();
+      ctx.strokeStyle = '#1a2029';
+      ctx.lineWidth = 2;
+      ctx.stroke();
+      ctx.font = `${city.isCapital ? 12 : 10}px serif`;
+      ctx.textAlign = 'center';
+      ctx.textBaseline = 'middle';
+      ctx.fillStyle = '#2d2730';
+      ctx.fillText(city.isCapital ? '★' : '•', x, y + 1);
+      ctx.restore();
+    });
+  }
+
+  private drawArmies(state: GameState, region: Region, center: Point): void {
+    const ctx = this.context;
+    const armies = state.armies.filter((army) => army.regionId === region.id && totalArmySize(army) > 0);
+    const player = nationById(state, state.playerNationId);
+    const visible = Boolean(player?.knownRegions.includes(region.id));
+    armies.forEach((army, index) => {
+      const nation = nationById(state, army.ownerId);
+      const x = center.x + (index - (armies.length - 1) / 2) * 25;
+      const y = center.y - this.tileHeight * 0.52 - Math.sin(this.animation + index) * 2;
+      const isOwn = army.ownerId === state.playerNationId;
+      ctx.save();
+      ctx.translate(x, y);
+      ctx.fillStyle = nation?.color || '#999';
+      ctx.strokeStyle = isOwn ? '#f5d58b' : '#151b23';
+      ctx.lineWidth = isOwn ? 2.5 : 1.5;
+      ctx.beginPath();
+      ctx.moveTo(0, -13);
+      ctx.lineTo(12, -8);
+      ctx.lineTo(10, 9);
+      ctx.lineTo(0, 14);
+      ctx.lineTo(-10, 9);
+      ctx.lineTo(-12, -8);
+      ctx.closePath();
+      ctx.fill();
+      ctx.stroke();
+      ctx.fillStyle = '#fff4d1';
+      ctx.font = 'bold 11px sans-serif';
+      ctx.textAlign = 'center';
+      ctx.textBaseline = 'middle';
+      ctx.fillText(isOwn || visible ? String(totalArmySize(army)) : '?', 0, 0);
+      ctx.restore();
+    });
+  }
+
+  private drawMapFrame(width: number, height: number): void {
+    const ctx = this.context;
+    ctx.save();
+    const vignette = ctx.createRadialGradient(width / 2, height / 2, height * 0.2, width / 2, height / 2, width * 0.72);
+    vignette.addColorStop(0, 'transparent');
+    vignette.addColorStop(1, 'rgba(4,8,13,.44)');
+    ctx.fillStyle = vignette;
+    ctx.fillRect(0, 0, width, height);
+    ctx.strokeStyle = 'rgba(219,181,106,.2)';
+    ctx.lineWidth = 1;
+    ctx.strokeRect(13, 13, width - 26, height - 26);
+    ctx.restore();
+  }
+}
