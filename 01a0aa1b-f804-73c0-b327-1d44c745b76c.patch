@@ -0,0 +1,270 @@
+@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Marhey:wght@400;600;700&display=swap');
+
+:root {
+  color-scheme: dark;
+  --bg: #0b1017;
+  --bg-soft: #111923;
+  --panel: rgba(20, 29, 40, .94);
+  --panel-deep: rgba(13, 19, 28, .96);
+  --line: rgba(211, 169, 91, .22);
+  --line-soft: rgba(211, 222, 225, .1);
+  --gold: #d7ad63;
+  --gold-bright: #f3d28a;
+  --text: #f0e7d2;
+  --muted: #96a3ad;
+  --danger: #e1786b;
+  --good: #7dc49c;
+  --blue: #74b8cb;
+  --shadow: 0 18px 60px rgba(0, 0, 0, .34);
+  font-family: 'Cairo', 'Segoe UI', sans-serif;
+  background: var(--bg);
+  color: var(--text);
+}
+
+* { box-sizing: border-box; }
+html, body { margin: 0; min-height: 100%; background: var(--bg); }
+body { overflow-x: hidden; }
+button, select { font: inherit; }
+button { color: inherit; cursor: pointer; }
+button:disabled { opacity: .48; cursor: not-allowed; }
+
+body::before {
+  content: '';
+  position: fixed;
+  z-index: 20;
+  pointer-events: none;
+  inset: 0;
+  opacity: .12;
+  background-image: radial-gradient(rgba(255,255,255,.45) .55px, transparent .55px);
+  background-size: 5px 5px;
+  mix-blend-mode: soft-light;
+}
+
+.app-shell { min-height: 100vh; padding: 14px; background: radial-gradient(circle at 80% 0%, rgba(49, 81, 94, .2), transparent 35%), linear-gradient(145deg, #0c1119 0%, #0a0f16 100%); }
+.topbar { width: min(1720px, 100%); margin: 0 auto 12px; min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 10px 16px; border: 1px solid var(--line); border-radius: 16px; background: linear-gradient(110deg, rgba(25, 35, 46, .96), rgba(14, 21, 31, .93)); box-shadow: var(--shadow); }
+.brand-block, .nation-heading, .army-command-head, .choice-top, .diplomacy-main, .pending-status { display: flex; align-items: center; gap: 11px; }
+.brand-mark { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 12px; color: #2a2116; font-size: 25px; background: linear-gradient(145deg, var(--gold-bright), #ab7c3f); box-shadow: 0 0 0 3px rgba(211, 168, 91, .1), inset 0 1px 0 rgba(255,255,255,.5); }
+.brand-block h1 { margin: 0; color: var(--gold-bright); font-family: 'Marhey', 'Cairo', sans-serif; font-size: 21px; line-height: 1.1; letter-spacing: -.3px; }
+.brand-block span { display: block; margin-top: 3px; color: var(--muted); font-size: 10px; }
+.turn-status { display: flex; align-items: center; justify-content: center; gap: 17px; color: var(--muted); }
+.turn-pill { display: flex; align-items: center; gap: 7px; padding: 6px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--gold-bright); font-size: 11px; background: rgba(210, 167, 91, .07); }
+.status-light { width: 7px; height: 7px; border-radius: 50%; background: var(--good); box-shadow: 0 0 12px var(--good); }
+.status-light.setup { background: var(--gold); box-shadow: 0 0 12px var(--gold); }
+.status-light.won { background: #83d6ae; box-shadow: 0 0 14px #83d6ae; }
+.status-light.lost { background: var(--danger); box-shadow: 0 0 14px var(--danger); }
+.date-readout { display: flex; flex-direction: column; line-height: 1.15; text-align: center; }
+.date-readout b { color: var(--text); font-size: 14px; }
+.date-readout span { color: var(--muted); font-size: 10px; }
+.nation-badge { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; color: var(--text); font-size: 11px; }
+.nation-badge i { width: 9px; height: 9px; display: inline-block; border-radius: 50%; box-shadow: 0 0 0 2px rgba(255,255,255,.12); }
+.top-actions { display: flex; gap: 7px; }
+.icon-button, .danger-button, .mini-button { border: 1px solid var(--line-soft); border-radius: 8px; padding: 7px 10px; color: var(--muted); background: rgba(255,255,255,.035); font-size: 11px; transition: .2s ease; }
+.icon-button:hover, .mini-button:hover { color: var(--gold-bright); border-color: var(--line); background: rgba(215,173,99,.1); }
+.danger-button { color: #ddb2a9; border-color: rgba(225,120,107,.28); }
