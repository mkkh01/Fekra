+.seed-label { color: rgba(215,173,99,.7); }
+
+.sidebar { display: flex; flex-direction: column; gap: 10px; min-width: 0; max-height: calc(100vh - 102px); overflow-y: auto; padding-left: 1px; scrollbar-width: thin; scrollbar-color: rgba(211,169,91,.28) transparent; }
+.sidebar > .panel { padding: 13px 14px; }
