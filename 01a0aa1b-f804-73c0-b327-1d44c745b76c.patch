+}
+@media (max-width: 780px) {
+  .app-shell { padding: 7px; }
+  .topbar { flex-wrap: wrap; gap: 9px; padding: 9px 11px; }
+  .brand-block { flex: 1 1 auto; }
+  .turn-status { order: 3; width: 100%; justify-content: space-between; padding-top: 7px; border-top: 1px solid var(--line-soft); }
+  .top-actions { margin-right: auto; }
+  .game-layout { display: block; }
+  .map-stage { margin-bottom: 10px; }
+  .sidebar { max-height: none; overflow: visible; display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); }
+  .sidebar > .panel:first-child, .sidebar > .panel:nth-child(2), .sidebar > .panel:nth-child(5), .sidebar > .panel:nth-child(6) { grid-column: span 2; }
+  .canvas-wrap { height: 54vh; min-height: 370px; }
+  .map-toolbar { align-items: flex-start; flex-direction: column; gap: 7px; }
+  .map-hints { gap: 7px; }
+  .bottom-bar { align-items: stretch; flex-direction: column; padding: 10px; }
+  .end-turn-button { width: 100%; }
+  .pending-status small { max-width: calc(100vw - 75px); }
+}
+@media (max-width: 480px) {
+  .nation-choices { grid-template-columns: 1fr; }
+  .setup-modal { padding: 20px 12px; }
+  .nation-choice p { min-height: 0; }
