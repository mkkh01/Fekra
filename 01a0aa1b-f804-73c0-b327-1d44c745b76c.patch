+import { Nation, ResourceKey, Resources } from './types.js';
+
+export const RESOURCE_LABELS: Record<ResourceKey, string> = {
+  food: 'غذاء',
+  gold: 'ذهب',
+  iron: 'حديد',
+  wood: 'خشب',
+  horses: 'خيول',
+  stone: 'حجر',
+};
+
+export const RESOURCE_ICONS: Record<ResourceKey, string> = {
+  food: '🌾',
+  gold: '✦',
+  iron: '⚒',
+  wood: '♣',
+  horses: '♞',
+  stone: '⬡',
+};
+
+export function number(value: number): string {
+  return Math.round(value).toLocaleString('ar-EG');
+}
+
+export function compact(value: number): string {
+  if (value >= 1000000) return `${(value / 1000000).toFixed(1)}م`;
+  if (value >= 1000) return `${(value / 1000).toFixed(value >= 10000 ? 0 : 1)}ك`;
+  return number(value);
+}
+
+export function resourcesMarkup(resources: Resources): string {
+  return (Object.keys(RESOURCE_LABELS) as ResourceKey[]).map((key) => `<div class="resource-chip" title="${RESOURCE_LABELS[key]}"><span>${RESOURCE_ICONS[key]}</span><b>${compact(resources[key])}</b><small>${RESOURCE_LABELS[key]}</small></div>`).join('');
+}
+
+export function nationBadge(nation?: Nation): string {
+  if (!nation) return '<span class="unknown-badge">غير معروف</span>';
+  return `<span class="nation-badge"><i style="background:${nation.color}"></i>${nation.shortName}</span>`;
+}
+
+export function escapeHtml(value: string): string {
+  return value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[character] || character));
+}
