# انسخ هذا الملف إلى .env محلياً فقط — لا ترفعه إلى Git أبداً.

# ── الاتصالات ──
DATABASE_URL=          # أو SUPABASE_URL — رابط Postgres (pooler)
REDIS_URL=

# ── تيليغرام ──
BOT_TOKEN=
ADMIN_CHAT_ID=         # إجباري: بدونه لن يستجيب البوت لأحد (يمنع الاستيلاء)
PUBLIC_URL=            # https://....onrender.com
WEBHOOK_SECRET=        # سلسلة عشوائية طويلة — تُرسلها تيليغرام كترويسة
ADMIN_API_TOKEN=       # لحماية / و /api/summary (يُشتق من BOT_TOKEN إن تُرك فارغاً)
ALLOW_AUTO_ADMIN=0     # 1 = اسمح لأول /start بأن يصبح مديراً (خطر)

# ── التشغيل ──
SCAN_INTERVAL_SEC=60   # حلقة المسح والقرار
MONITOR_INTERVAL_SEC=5 # حلقة تقييم TP/SL (أسرع = خروج أدق)
PAPER_EQUITY=10000
RUN_SCHEDULER=1
ENABLE_DAY=1
ENABLE_FALCON=1
PRUNE_DAYS=30

# ── نموذج التكاليف ──
FEE_BPS=2.0
SLIP_BASE_BPS=1.0
SLIP_IMPACT_K=0.6
SLIP_MIN_BPS=0.5
SLIP_MAX_BPS=25.0
SLIPPAGE_SIM_BPS=2.0   # يُستخدم في المحاكاة فقط

# ── تمويل العقود الدائمة ──
FUNDING_ENABLED=1
FUNDING_RATE_8H=0.0001

# ── حدود المخاطر (0 = معطّل) ──
DAILY_LOSS_HALT=0.0
MAX_DRAWDOWN_HALT=0.0

MARKET_TIMEOUT_SEC=6
