# Runtime
APP_ENV=development
APP_NAME=Fekra Trading Brain
TRADING_MODE=PAPER
LOG_LEVEL=INFO

# Required server-side services
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-server-side-key
REDIS_URL=redis://localhost:6379/0

# Gemini: use either GEMINI_API_KEY for one account or five numbered accounts.
# Never expose these values in frontend code or commit them to Git.
GEMINI_API_KEY=
GEMINI_API_KEY_1=replace-in-render
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODEL=gemini-3.7-flash

# Dashboard/API
CORS_ORIGINS=http://localhost:8000
JWT_SECRET=replace-with-a-long-random-secret

# Optional; RSS news works without paid API keys
NEWS_POLL_SECONDS=300
RSS_FEEDS=https://www.cryptobriefing.com/feed/;https://www.ccn.com/news/crypto-news/feeds/;https://cointelegraph.com/rss;https://www.coindesk.com/arc/outboundfeeds/rss/;https://decrypt.co/feed

# Only for a future LIVE_GUARDED phase; leave empty for PAPER
BINANCE_API_KEY=
BINANCE_API_SECRET=
